class Solution {
    int lowerbound(vector<int>&nums,int target)
    {
        int s = 0, e = nums.size()-1,answer = -1;
        while(s<=e)
        {
            int mid = (s+e)/2;
            if (nums[mid]==target)
            {
                answer=mid;
                e =mid-1;
            }
            else if(nums[mid]==target)
            {
                s= mid+1;
            }
            else{
                e=mid-1;
            }
        }
        return answer;
    }
    int upperbound(vector<int>&nums,int target)
    {
        int s = 0, e = nums.size()-1,answer = -1;
        while(s<=e)
        {
            int mid = (s+e)/2;
            if (nums[mid]==target)
            {
                answer =mid;
                e =mid+1;
            }
            else if(nums[mid]==target)
            {
                s= mid+1;
            }
            else{
                e=mid-1;
            }
        }
        return answer;
    }
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        vector<int> arr;
        int first = lowerbound(nums,target);
        int last = upperbound(nums,target);
        arr.push_back(first);
        arr.push_back(last);
        return arr;
        
    }
};
